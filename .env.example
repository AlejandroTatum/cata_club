# Root env for docker-compose.yml — copy to .env and fill in.
#
# REQUIRED: JWT_SECRET_KEY must be set or docker-compose will fail to start.
# Generate a secure key:  openssl rand -hex 32
#
# This template covers development (safe dev defaults baked into
# docker-compose.yml). For production there is a dedicated template:
# .env.production.example — copy it on the host as .env (chmod 600) and fill
# every value. Runbook: docs/operations/deployment.md
# Full per-variable inventory: docs/reference/configuration.md

# --- Database (safe dev defaults baked into docker-compose.yml) ---
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
POSTGRES_DB=cataclub_db

# --- JWT (REQUIRED) ---
JWT_SECRET_KEY=

# --- Environment: "development" enables crear_tablas + seed on startup ---
AMBIENTE=development

# --- CORS (CSV or JSON list of allowed frontend origins) ---
# Dev default is http://localhost:3000; the prod overlay REQUIRES the real
# origin (no default) and fails the compose render if unset or empty.
CORS_ORIGENES=

# --- Transactional email / SMTP ---
# Dev defaults target the local mailpit catcher. In production the backend
# fail-fast rejects empty/missing SMTP_HOST and any mailpit/mailhog host,
# and STARTTLS defaults to true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cataclub.com
SMTP_STARTTLS=true

# --- Frontend URL (links inside transactional emails) ---
# Dev default is http://localhost:3000; in production it must be an absolute
# https URL that is NOT a loopback (backend fail-fast).
FRONTEND_URL=

# --- Production only: Caddy ingress / TLS (compose prod requires them) ---
# DOMINIO=app.example.com        # certificate host + entry host
# ACME_EMAIL=ops@example.com     # Let's Encrypt contact

# --- Production only: the single host search engines may index ---
# Caddy compares each request's Host against this value and answers
# `X-Robots-Tag: noindex, nofollow` when they differ, so this same stack
# pointed at a staging host does not get indexed. In production set it to the
# same value as DOMINIO; on staging leave it alone (or unset). When missing it
# falls back to a reserved `.invalid` host, which marks the WHOLE site
# noindex — it can never fail open into an indexable staging site.
# DOMINIO_INDEXABLE=app.example.com

# --- Production only: immutable image SHA to deploy (never "latest") ---
# IMAGE_TAG=<full-commit-sha>

# --- Cloudinary (optional — leave empty to skip file uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Chatbot de FAQ (gateway OpenCode Zen) — OPCIONAL ---
# Vacío es válido: el chatbot responde desde su FAQ local y el backend arranca
# igual (no está en el fail-fast de producción). El propietario entrega la
# clave fuera de banda; NUNCA se commitea.
#
# Escribila sin comillas y sin comentario en la misma línea: Compose interpola
# ambos como parte del valor y el proveedor rechaza la credencial sin que se
# note, porque el chatbot degrada en silencio a su FAQ local.
#
# Comprobar la configuración sin imprimir el secreto:
#   docker compose exec backend uv run python scripts/verificar_chatbot.py
# Configuración inicial, verificación, rotación y revocación:
#   docs/operations/provisioning.md
OPENCODE_API_KEY=

# --- Chatbot: modelo y gateway (issue #766) ---
# Se sacaron de constantes hardcodeadas para que cambiar un modelo gratuito
# retirado sea reiniciar contenedores, no desplegar codigo.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
CHATBOT_MODELO=mimo-v2.5-free
# Separados por coma. Solo se prueba el siguiente ante un 404 (id retirado):
# un 401 o un 429 fallan igual en cualquier modelo.
CHATBOT_MODELOS_RESPALDO=deepseek-v4-flash-free
