# Secrets
.env
.env.*
# Covers .env.example and frontend/.env.local.example; the narrower
# !.env.example did not rescue the latter, leaving a tracked file ignored.
!.env*.example

# OS
.DS_Store
Thumbs.db

# IDEs
# No trailing slash: in this checkout these exist as files, not directories,
# and a trailing-slash pattern would not match them.
.vscode
.idea
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
.next/
out/
*.tsbuildinfo
coverage/

# Docker
*.log

# Test artifacts
test-results/
playwright-report/

# Playwright MCP's own session output (screenshots, console logs, page
# snapshots) — a different tool from the `playwright-report/` test runner
# above, and previously untracked AND unignored: the exact shape that let
# `.claude/` slip into the index with a `git add -A` before it was covered.
# `**/` guards every directory the tool gets invoked from, not just the repo
# root, the same reason `.claude/` needed the same treatment below.
**/.playwright-mcp/

# AI orchestrator artifacts
.atl/
.codegraph/
.engram/

# Developer environment leaking into the repository root
# This checkout hosts the developer's home-level dotfiles at the repository
# root. They are untracked, and before this section they were also unignored,
# so a `git add -A` would have staged real credentials. The repository is
# public, so these must never be committed.
.aws/
.config/
.gitconfig
.mcp.json
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.ripgreprc

# Claude Code local state.
# `.claude/settings.local.json` and `.claude/skills/` are already tracked, so
# only the unversioned siblings are ignored.
.claude/*
!.claude/settings.local.json
!.claude/skills/

# The same state, everywhere else it lands.
#
# A pattern containing a slash is anchored to the directory holding this file,
# so the rule above only ever covered `/.claude/`. The tooling writes a scratch
# directory into every folder it edits in, and thirteen of them had accumulated
# — `frontend/.claude/`, `backend/.claude/`, `frontend/src/services/.claude/`,
# `frontend/public/fonts/.impeccable/` and so on. None were ignored, all were
# one `git add -A` away from the index, and none of them mean anything to a
# fresh clone.
#
# `**/` matches zero or more leading directories, so each rule below covers
# both `frontend/.claude/` and `frontend/src/.../.claude/`.
frontend/**/.claude/
backend/**/.claude/
docs/**/.claude/
tests/**/.claude/
**/.impeccable/
