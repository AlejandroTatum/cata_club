  "faq": [
    {
      "titulo": "Para empezar",
      "entradas": [
        {
          "pregunta": "¿Cómo inicio sesión?",
          "respuesta": "Ingrese con su correo y contraseña. Si olvidó la contraseña, solicite un enlace de recuperación en la pantalla de inicio de sesión."
        },
        {
          "pregunta": "¿Cuáles son los horarios?",
          "respuesta": "Consulte los horarios vigentes en la sección Horarios de la página principal."
        },
        {
          "pregunta": "¿Cuánto cuesta la mensualidad?",
          "respuesta": "Consulte el valor de su plan en Mi Cuenta. Para conocer los planes disponibles, escriba al club por WhatsApp."
        },
        {
          "pregunta": "¿Por qué mi pantalla no se parece a la de otra persona del club?",
          "respuesta": "Cada persona ve las funciones que corresponden a su rol: administrador, entrenador o familia."
        }
      ]
    },
    {
      "titulo": "Si es estudiante o representante",
      "entradas": [
        {
          "pregunta": "¿Dónde veo si mi pago fue aprobado?",
          "respuesta": "En Mi Cuenta puede consultar el estado de sus pagos y de su membresía. Si un pago fue rechazado, verá el motivo y podrá enviar otro comprobante."
        },
        {
          "pregunta": "¿Dónde veo la asistencia?",
          "respuesta": "En Mi Cuenta puede consultar las clases y asistencias registradas."
        },
        {
          "pregunta": "Necesito corregir la ficha médica. ¿Puedo hacerlo yo?",
          "respuesta": "Sí, si gestiona su propia cuenta o representa al estudiante. Abra Ficha médica en Mi Cuenta. La ficha de un menor con cuenta propia la corrige su representante o un administrador."
        },
        {
          "pregunta": "Represento a más de un hijo. ¿Cómo cambio entre ellos?",
          "respuesta": "Use el selector de estudiante en Mi Cuenta para elegir a quién desea consultar."
        }
      ]
    },
    {
      "titulo": "Si es entrenador",
      "entradas": [
        {
          "pregunta": "¿Cómo tomo asistencia?",
          "respuesta": "Abra Asistencia, elija el horario, pase lista y confirme."
        },
        {
          "pregunta": "Me equivoqué al marcar. ¿Puedo deshacerlo?",
          "respuesta": "Sí. Use Deshacer en la barra inferior para revertir la última acción."
        },
        {
          "pregunta": "¿Dónde veo lo que ya cargué?",
          "respuesta": "En Historial Asistencia puede consultar las listas registradas."
        }
      ]
    },
    {
      "titulo": "Si es administrador",
      "entradas": [
        {
          "pregunta": "¿Cómo valido un pago?",
          "respuesta": "Abra Membresías y Pagos, revise la solicitud y confirme su decisión."
        },
        {
          "pregunta": "Tengo muchos pagos iguales. ¿Debo aprobarlos de a uno?",
          "respuesta": "Sí. Cada solicitud se revisa y aprueba por separado."
        },
        {
          "pregunta": "Aprobé un pago por error. ¿Puedo revertirlo?",
          "respuesta": "Puede usar Deshacer durante los segundos posteriores a la aprobación. Después, el pago queda registrado."
        },
        {
          "pregunta": "¿Quién define los horarios?",
          "respuesta": "El administrador los configura en Horarios."
        },
        {
          "pregunta": "¿Dónde genero los reportes del club?",
          "respuesta": "En Reportes puede generar los informes con los datos registrados."
        }
      ]
    }
  ],
