# Caddyfile de PRODUCCIÓN. Lo monta de solo lectura el servicio `caddy` de
# `docker-compose.prod.yml`, en `/etc/caddy/Caddyfile`. Deliberadamente NO va
# en el `command:` de ese servicio -- versionarlo acá permite diffear la
# configuración del ingress igual que cualquier otro archivo del repo, y
# `caddy validate` puede correr sobre este archivo sin levantar el stack.
#
# `{$DOMINIO}` y `{$ACME_EMAIL}` los resuelve Caddy leyendo el entorno del
# propio proceso (Caddy soporta interpolación de variables de entorno de
# forma nativa) -- el `environment:` del servicio `caddy` en el compose los
# inyecta. Ambos ya son obligatorios en el compose
# (`${DOMINIO:?...}`/`${ACME_EMAIL:?...}`), así que si este archivo se
# procesa es porque los dos existen.
{
	email {$ACME_EMAIL}
}

{$DOMINIO} {
	# TLS automático vía Let's Encrypt: comportamiento por defecto de Caddy
	# 2.x para cualquier dirección que no sea `localhost` ni una IP -- no
	# hace falta declarar `tls` explícito.

	# ── Readiness para el monitor externo ─────────────────────────────────
	#
	# El backend NO se expone a internet: lo consume el frontend por la red
	# interna de Docker. Esta es la única excepción, y es del ancho exacto de
	# lo que necesita un monitor externo (UptimeRobot; ver
	# docs/operations/monitoring.md): saber si la app puede atender.
	#
	# `handle` y no un `reverse_proxy` con matcher: los bloques `handle` son
	# MUTUAMENTE EXCLUYENTES y se evalúan en el orden escrito, así que todo lo
	# que no sea exactamente este path cae en el catch-all del frontend de
	# abajo, sin solapamiento posible entre las dos rutas.
	#
	# El matcher es el path EXACTO, sin `*`. Un prefijo (`/health*`) alcanzaría
	# también a `/docs` y a `/diagnostico/circuitos` -- esta última exige rol
	# ADMINISTRADOR y vive fuera de `/health` justamente para que nadie la
	# confunda con una sonda anónima (ver el comentario largo de
	# backend/main.py arriba de esa ruta). `/health` a secas queda afuera
	# también a propósito: es la sonda de liveness del orquestador y no le
	# aporta nada a un monitor que ya sabe si el sitio contesta.
	#
	# Verificado corriendo `caddy:2.8-alpine` de verdad contra dos upstreams de
	# prueba: `/health/ready` llega al backend, mientras que `/health`, `/docs`,
	# `/diagnostico/circuitos`, `/health/ready/` y `/health/readyX` caen todos
	# en el frontend. El matcher de path de Caddy es case-insensitive, así que
	# `/HEALTH/READY` también llega al backend -- ahí FastAPI devuelve su 404
	# pelado, que no expone nada.
	#
	# La respuesta es anónima y deliberadamente muda: `200 {"estado": "listo"}`
	# o `503` sin decir qué dependencia se cayó. `caddy` resuelve `backend:8000`
	# porque ambos servicios comparten la red `default` del proyecto Compose --
	# no hay `networks:` declarado en ninguno de los dos archivos del render.
	handle /health/ready {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000 {
			# Fija X-Forwarded-For al peer TCP real -- issue #235, mitad 2.
			# `{remote_host}` es la conexión que le llega a Caddy, no negociable
			# por el cliente.
			#
			# Verificado con curl contra un upstream echo detrás de este mismo
			# Caddy (2.8-alpine): SIN esta directiva, `reverse_proxy` ya
			# reemplaza (no anexa) cualquier X-Forwarded-For que mande el
			# visitante por el peer real, mientras no haya `trusted_proxies`
			# declarado en la config global. O sea que hoy esta línea no cambia
			# ningún comportamiento en runtime.
			#
			# Se deja igual, explícita, porque ese default es una propiedad de
			# la config global de Caddy, no del backend: el día que alguien
			# agregue `trusted_proxies` acá (para, por ejemplo, meter un CDN
			# adelante) el default deja de reemplazar y pasa a anexar según esa
			# lista -- y el backend (rate_limit.py, `clave_cliente`) sigue
			# confiando ciegamente en `X-Forwarded-For` en cuanto uvicorn ve a
			# este frontend como peer de confianza
			# (`--forwarded-allow-ips`, backend/Dockerfile). Sin esta línea, ese
			# cambio reabriría en silencio el keying del rate limit anónimo por
			# visitante (issue #235) sin que ningún test se ponga en rojo.
			#
			# Por eso `caddy validate` marca esta directiva como
			# "Unnecessary header_up X-Forwarded-For": el validador solo conoce
			# el default de HOY, no esta protección a futuro. Ese warning es
			# esperado -- no es señal de que haya que borrarla.
			header_up X-Forwarded-For {remote_host}
		}
	}

	encode gzip

	header {
		# El backend solo asoma por `/health/ready` (bloque `handle` de más
		# arriba); todo lo demás lo consume el frontend por la red interna de
		# Docker. Este header endurece al único origen público del stack.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Este sistema sirve fichas médicas de menores y comprobantes de
		# pago, y este es el único borde público -- los tres headers de
		# abajo no cuestan nada y cierran clases enteras de ataque.

		# Evita que el navegador adivine el tipo de contenido de una
		# respuesta y termine ejecutando como script algo que no lo es.
		X-Content-Type-Options "nosniff"

		# Evita que el sitio se embeba en un iframe ajeno (clickjacking)
		# sobre un formulario que maneja datos sensibles.
		X-Frame-Options "DENY"

		# Evita que la URL completa (con IDs de fichas médicas o
		# comprobantes) viaje como referrer hacia un sitio de terceros.
		Referrer-Policy "strict-origin-when-cross-origin"

		# Apaga las APIs de navegador que la app NO usa. Si alguna vez
		# entra un script de terceros (o un XSS) por cualquier vía, este
		# header le niega de entrada la cámara, el micrófono y la
		# ubicación del visitante -- en un sitio que ya maneja datos de
		# menores, esas tres son las que importan.
		#
		# La lista se derivó del código, no de una plantilla copiada. Lo
		# verificado en frontend/src:
		#
		#   - `navigator.*` no aparece NI UNA VEZ fuera de los tests: no
		#     hay geolocation, getUserMedia, clipboard, share ni
		#     serviceWorker.
		#   - El mapa de la landing es Leaflet centrado en una CONSTANTE
		#     (`CLUB_POSITION` en frontend/src/app/landing/club-location.ts,
		#     derivada de un Plus Code), no en la ubicación del visitante.
		#     No hay `map.locate()` ni control de localización. Por eso
		#     `geolocation=()` no puede romperlo -- era el único riesgo
		#     real de esta lista.
		#   - "Cómo llegar" es un `<a href>` a openstreetmap.org, no una
		#     llamada a ninguna API.
		#   - Los pagos son subida de comprobante + validación manual
		#     (`proofFileName`/`voucherUrl`), no la Payment Request API:
		#     no hay Stripe, PayPal ni MercadoPago en package.json.
		#   - Los `<input type="file">` (comprobantes, foto de perfil,
		#     sponsors) NO llevan el atributo `capture`, y el picker del
		#     sistema operativo no lo gobierna este header: `camera=()` no
		#     afecta la opción "Tomar foto" del celular.
		#
		# Quedan DELIBERADAMENTE FUERA tres features que la app tampoco
		# usa hoy, porque el costo de equivocarse es una función rota en
		# silencio y la ganancia de seguridad es marginal:
		# `autoplay` (la landing está en rediseño y un video hero es
		# plausible), `fullscreen` y `clipboard-write` (un botón de
		# "copiar enlace" es de lo más común que se agrega después).
		# Agregarlas es una línea el día que se decida.
		#
		# `window.print()` (botón "Imprimir carnet") no se ve afectado:
		# no existe ninguna directiva `print` en Permissions-Policy.
		Permissions-Policy "accelerometer=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"

		# Content-Security-Policy -- fase 1 (issue #1069): report-only, no la
		# cabecera que bloquea. Se construyó mirando lo que Next.js
		# efectivamente inyecta, no a ciegas:
		#
		#   - `script-src 'self' 'unsafe-inline'`: verificado compilando la
		#     app, el App Router inyecta 6 `<script>` inline SIN `src` y SIN
		#     nonce en `/login` (el payload `self.__next_f.push(...)` del
		#     streaming de RSC). Sin `'unsafe-inline'` la hidratación se
		#     rompe. Pasar a modo estricto exige decidir entre conservar esto
		#     (una CSP materialmente más débil) o construir plomería de
		#     nonce en el middleware, que hoy no existe.
		#   - `style-src 'self' 'unsafe-inline'`: hay `style={{...}}` inline
		#     en 13 archivos del frontend (p. ej. `StatCard.tsx`,
		#     `landing/HeroCarousel.tsx`).
		#   - `img-src`: `res.cloudinary.com` sirve fotos de perfil y logos
		#     de sponsors; `*.tile.openstreetmap.org` sirve los tiles del
		#     mapa de la landing.
		#   - `frame-src https://api.cloudinary.com`: los comprobantes de
		#     pago en PDF se previsualizan en un `<iframe>` a Cloudinary.
		#   - `connect-src 'self'`: todas las llamadas del navegador van
		#     same-origin al BFF de Next (`frontend/src/services/api.ts`);
		#     no hay fetch directo al backend ni a ningún tercero.
		#   - `font-src 'self'`: las fuentes son self-hosted
		#     (`next/font/local`, `frontend/src/lib/fonts.ts`), no hay CDN.
		#   - `frame-ancestors 'none'` y `base-uri 'self'`: mismo espíritu
		#     que `X-Frame-Options: DENY` de arriba, y evita que una
		#     inyección reescriba la base de las URLs relativas.
		#
		# `report-uri` apunta al endpoint propio de la app
		# (`frontend/src/app/api/csp-report/route.ts`), no a un proveedor
		# externo: esta fase solo junta reportes reales para poder decidir
		# el modo estricto sobre evidencia, no sobre una suposición.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://res.cloudinary.com https://*.tile.openstreetmap.org; frame-src https://api.cloudinary.com; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; report-uri /api/csp-report"
	}

	# ── Indexación: solo el dominio de producción es indexable ────────────
	#
	# Este mismo archivo es el que se despliega en CUALQUIER host: está
	# parametrizado por `{$DOMINIO}` justamente para eso. Apuntado a un
	# staging o a una preview alcanzable desde internet, los buscadores lo
	# recorren e indexan una copia del sitio -- con fichas médicas de
	# menores y comprobantes de pago detrás del login, pero con las URLs,
	# la estructura y la landing entera al aire, y compitiendo contra el
	# dominio real por posicionamiento.
	#
	# La decisión es qué se compara y contra qué. NO se usa un booleano del
	# estilo `ES_PRODUCCION`: el `.env` de producción se copia entero a
	# staging todo el tiempo, y un booleano copiado dice `true` en el host
	# equivocado -- el modo de falla más probable termina en "staging
	# indexado", que es exactamente lo que hay que evitar.
	#
	# Se compara el HOST REAL de la petición contra `DOMINIO_INDEXABLE`, el
	# único host que puede aparecer en un buscador. Copiar el `.env` a
	# staging ahora funciona a favor: `DOMINIO` cambia (es el host que se
	# sirve) y `DOMINIO_INDEXABLE` se queda con el dominio real, así que los
	# dos dejan de coincidir y el sitio sale `noindex` solo.
	#
	# El default NO PUEDE FALLAR ABIERTO. `ninguno.invalid` es un TLD
	# reservado (RFC 2606): ningún host público puede ser igual a ese valor,
	# así que si la variable falta, viene vacía o está mal escrita, la
	# comparación falla para TODA petición y el sitio entero queda
	# `noindex`. Un despliegue mal configurado se cae del lado de "no me
	# indexen"; nunca del lado de "staging indexable". El precio explícito
	# de esa elección: si producción se olvida de exportar
	# `DOMINIO_INDEXABLE`, producción deja de indexarse. Es visible con un
	# `curl -I` y se revierte con una variable -- al revés no: una copia de
	# staging ya indexada sobrevive en el buscador mucho después del
	# arreglo.
	#
	# `docker-compose.prod.yml` inyecta la variable con este mismo default,
	# para que las dos capas coincidan.
	@no_es_el_dominio_indexable not host {$DOMINIO_INDEXABLE:ninguno.invalid}
	header @no_es_el_dominio_indexable X-Robots-Tag "noindex, nofollow"
}
