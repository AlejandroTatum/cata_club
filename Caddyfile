# Caddyfile de PRODUCCIÓN. Lo monta de solo lectura el servicio `caddy` de
# `docker-compose.prod.yml`, en `/etc/caddy/Caddyfile`. Deliberadamente NO va
# en el `command:` de ese servicio -- versionarlo acá permite diffear la
# configuración del ingress igual que cualquier otro archivo del repo, y
# `caddy validate` puede correr sobre este archivo sin levantar el stack.
#
# `{$DOMINIO}` y `{$ACME_EMAIL}` los resuelve Caddy leyendo el entorno del
# propio proceso (Caddy soporta interpolación de variables de entorno de
# forma nativa) -- el `environment:` del servicio `caddy` en el compose los
# inyecta. Ambos ya son obligatorios en el compose
# (`${DOMINIO:?...}`/`${ACME_EMAIL:?...}`), así que si este archivo se
# procesa es porque los dos existen.
{
	email {$ACME_EMAIL}
}

{$DOMINIO} {
	# TLS automático vía Let's Encrypt: comportamiento por defecto de Caddy
	# 2.x para cualquier dirección que no sea `localhost` ni una IP -- no
	# hace falta declarar `tls` explícito.

	reverse_proxy frontend:3000 {
		# Fija X-Forwarded-For al peer TCP real -- issue #235, mitad 2.
		# `{remote_host}` es la conexión que le llega a Caddy, no negociable
		# por el cliente.
		#
		# Verificado con curl contra un upstream echo detrás de este mismo
		# Caddy (2.8-alpine): SIN esta directiva, `reverse_proxy` ya
		# reemplaza (no anexa) cualquier X-Forwarded-For que mande el
		# visitante por el peer real, mientras no haya `trusted_proxies`
		# declarado en la config global. O sea que hoy esta línea no cambia
		# ningún comportamiento en runtime.
		#
		# Se deja igual, explícita, porque ese default es una propiedad de
		# la config global de Caddy, no del backend: el día que alguien
		# agregue `trusted_proxies` acá (para, por ejemplo, meter un CDN
		# adelante) el default deja de reemplazar y pasa a anexar según esa
		# lista -- y el backend (rate_limit.py, `clave_cliente`) sigue
		# confiando ciegamente en `X-Forwarded-For` en cuanto uvicorn ve a
		# este frontend como peer de confianza
		# (`--forwarded-allow-ips`, backend/Dockerfile). Sin esta línea, ese
		# cambio reabriría en silencio el keying del rate limit anónimo por
		# visitante (issue #235) sin que ningún test se ponga en rojo.
		#
		# Por eso `caddy validate` marca esta directiva como
		# "Unnecessary header_up X-Forwarded-For": el validador solo conoce
		# el default de HOY, no esta protección a futuro. Ese warning es
		# esperado -- no es señal de que haya que borrarla.
		header_up X-Forwarded-For {remote_host}
	}

	encode gzip

	header {
		# El backend nunca se expone (lo consume el frontend por la red
		# interna de Docker); este header solo endurece al único origen
		# público del stack.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Este sistema sirve fichas médicas de menores y comprobantes de
		# pago, y este es el único borde público -- los tres headers de
		# abajo no cuestan nada y cierran clases enteras de ataque.

		# Evita que el navegador adivine el tipo de contenido de una
		# respuesta y termine ejecutando como script algo que no lo es.
		X-Content-Type-Options "nosniff"

		# Evita que el sitio se embeba en un iframe ajeno (clickjacking)
		# sobre un formulario que maneja datos sensibles.
		X-Frame-Options "DENY"

		# Evita que la URL completa (con IDs de fichas médicas o
		# comprobantes) viaje como referrer hacia un sitio de terceros.
		Referrer-Policy "strict-origin-when-cross-origin"

		# Content-Security-Policy: falta a propósito. Una CSP escrita a
		# ciegas rompe Next.js (scripts inline, estilos, hidratación) y no
		# se puede probar contra la app real en este momento. Tiene que
		# construirse mirando lo que Next.js efectivamente inyecta y
		# verificarse en un navegador -- no acá, no sin esa verificación.
	}

	# ── Indexación: solo el dominio de producción es indexable ────────────
	#
	# Este mismo archivo es el que se despliega en CUALQUIER host: está
	# parametrizado por `{$DOMINIO}` justamente para eso. Apuntado a un
	# staging o a una preview alcanzable desde internet, los buscadores lo
	# recorren e indexan una copia del sitio -- con fichas médicas de
	# menores y comprobantes de pago detrás del login, pero con las URLs,
	# la estructura y la landing entera al aire, y compitiendo contra el
	# dominio real por posicionamiento.
	#
	# La decisión es qué se compara y contra qué. NO se usa un booleano del
	# estilo `ES_PRODUCCION`: el `.env` de producción se copia entero a
	# staging todo el tiempo, y un booleano copiado dice `true` en el host
	# equivocado -- el modo de falla más probable termina en "staging
	# indexado", que es exactamente lo que hay que evitar.
	#
	# Se compara el HOST REAL de la petición contra `DOMINIO_INDEXABLE`, el
	# único host que puede aparecer en un buscador. Copiar el `.env` a
	# staging ahora funciona a favor: `DOMINIO` cambia (es el host que se
	# sirve) y `DOMINIO_INDEXABLE` se queda con el dominio real, así que los
	# dos dejan de coincidir y el sitio sale `noindex` solo.
	#
	# El default NO PUEDE FALLAR ABIERTO. `ninguno.invalid` es un TLD
	# reservado (RFC 2606): ningún host público puede ser igual a ese valor,
	# así que si la variable falta, viene vacía o está mal escrita, la
	# comparación falla para TODA petición y el sitio entero queda
	# `noindex`. Un despliegue mal configurado se cae del lado de "no me
	# indexen"; nunca del lado de "staging indexable". El precio explícito
	# de esa elección: si producción se olvida de exportar
	# `DOMINIO_INDEXABLE`, producción deja de indexarse. Es visible con un
	# `curl -I` y se revierte con una variable -- al revés no: una copia de
	# staging ya indexada sobrevive en el buscador mucho después del
	# arreglo.
	#
	# `docker-compose.prod.yml` inyecta la variable con este mismo default,
	# para que las dos capas coincidan.
	@no_es_el_dominio_indexable not host {$DOMINIO_INDEXABLE:ninguno.invalid}
	header @no_es_el_dominio_indexable X-Robots-Tag "noindex, nofollow"
}
